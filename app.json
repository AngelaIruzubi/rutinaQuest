{
  "expo": {
    "name": "gestor-tareas-gamificado",
    "slug": "gestor-tareas-gamificado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono.gif",
    "scheme": "gestortareasgamificado",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icono.png",
        "backgroundImage": "./assets/images/icono.png",
        "monochromeImage": "./assets/images/icono.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
     "splash": {
      "image": "./assets/images/icono.gif",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0F6"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icono.gif"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icono.gif",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        },
      ],
      [
         "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A77BBE",
          "iosDisplayInForeground": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
