{
  "expo": {
    "name": "RutinaQuest",
    "slug": "rutinaquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono.png",
    "scheme": "rutinaquest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rutinaquest.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icono.png",
        "backgroundImage": "./assets/images/icono.png",
        "monochromeImage": "./assets/images/icono.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.rutinaquest.app",
      "permissions": ["POST_NOTIFICATIONS", "RECEIVE_BOOT_COMPLETED", "VIBRATE"],
      "allowBackup": false
    },
    "splash": {
      "image": "./assets/images/icono.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6F0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icono.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icono.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6F0",
          "dark": {
            "backgroundColor": "#FBF6F0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A77BBE",
          "iosDisplayInForeground": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "angela-ns"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60959c6a-ff6a-432f-bff1-9822e37a3aa2"
      }
    },
    "owner": "angelairu"
  }
}
